<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="prismatic_fr3_duo">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="use_isaac" default="true" />

    <!-- Import prismatic_fr3_duo urdf file -->
    <xacro:include filename="$(find prismatic_fr3_duo_description)/urdf/prismatic_fr3_duo.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="prismatic_fr3_duo.ros2_control.xacro" />


    <xacro:prismatic_fr3_duo_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)" use_isaac="$(arg use_isaac)"/>

</robot>
